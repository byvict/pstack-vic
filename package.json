{
  "name": "pstack-vic",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Port autoral do pstack para Claude Code e Codex. Tooling do plugin roda em Node 24 (TypeScript direto, sem build).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'scripts/**/*.test.ts' 'skills/poteto-mode/scripts/runner/*.test.ts' 'skills/setup-pstack/scripts/*.test.ts' 'skills/poteto-mode/scripts/converge/**/*.test.ts'",
    "matrix:render": "node scripts/render-model-matrix.ts",
    "matrix:check": "node scripts/render-model-matrix.ts --check",
    "agents:generate": "node scripts/generate-agents.ts",
    "agents:check": "node scripts/generate-agents.ts --check",
    "collision:check": "bash tests/skill-collision-repro.sh",
    "upstream:digest": "node scripts/upstream-digest.ts",
    "runner": "node skills/poteto-mode/scripts/runner/pstack-runner",
    "setup-pstack": "node skills/setup-pstack/scripts/setup-pstack.ts"
  }
}
